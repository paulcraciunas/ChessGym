# Auto-detect text files and ensure LF line endings
* text=auto eol=lf

# Explicitly declare text files
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.conf text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
