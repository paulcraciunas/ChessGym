<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">
    <cloud-backup>
        <!-- Include general shared preferences if any -->
        <include domain="sharedpref" path="." />

        <!-- DataStore files (stored in files/datastore/) -->
        <!-- We include the directory but specifically exclude app_settings -->
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/app_settings.preferences_pb" />

        <!-- Exclude large puzzle database from cloud backup to save space.
             This can be re-downloaded upon first launch. -->
        <exclude domain="database" path="puzzle_database" tools:ignore="FullBackupContent" />
        <exclude domain="database" path="puzzle_database-shm" tools:ignore="FullBackupContent" />
        <exclude domain="database" path="puzzle_database-wal" tools:ignore="FullBackupContent" />
    </cloud-backup>

    <device-transfer>
        <!-- Device-to-device transfer should include everything for a seamless transition -->
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />

        <include domain="database" path="puzzle_database" tools:ignore="FullBackupContent" />
        <include domain="database" path="puzzle_database-shm" tools:ignore="FullBackupContent" />
        <include domain="database" path="puzzle_database-wal" tools:ignore="FullBackupContent" />
    </device-transfer>
</data-extraction-rules>
